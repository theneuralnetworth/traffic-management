<?xml version="1.0"?>
<sdf version="1.6">
  <world name="TrafficWorld">
    <!-- Sun and ground -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- North–South road -->
    <model name="road_ns">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <box>
              <size>2 20 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <box>
              <size>2 20 0.01</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- East–West road -->
    <model name="road_ew">
      <static>true</static>
      <pose>0 0 0 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <box>
              <size>2 20 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <box>
              <size>2 20 0.01</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Pole & Stop light 0 -->
    <model name="pole_0">
      <static>true</static>
      <pose> -1  2.5 1 0 0 0</pose>
      <link name="pole_link">
        <visual name="pole_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="pole_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>
    <include>
      <uri>model://stop_light</uri>
      <name>stop_light_0</name>
      <pose> -1  2.5 2 0 0 3.1416</pose>
      <plugin name="traffic_light_control_0" filename="libtraffic_light_plugin.so">
        <ros>
          <namespace>/stop_light_0</namespace>
          <node_name>stop_light_0_node</node_name>
        </ros>
        <traffic_light_id>0</traffic_light_id>
      </plugin>
    </include>

    <!-- Pole & Stop light 1 -->
    <model name="pole_1">
      <static>true</static>
      <pose> 2.5  1 1 0 0 0</pose>
      <link name="pole_link">
        <visual name="pole_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="pole_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>
    <include>
      <uri>model://stop_light</uri>
      <name>stop_light_1</name>
      <pose> 2.5  1 2 0 0 1.5708</pose>
      <plugin name="traffic_light_control_1" filename="libtraffic_light_plugin.so">
        <ros>
          <namespace>/stop_light_1</namespace>
          <node_name>stop_light_1_node</node_name>
        </ros>
        <traffic_light_id>1</traffic_light_id>
      </plugin>
    </include>

    <!-- Pole & Stop light 2 -->
    <model name="pole_2">
      <static>true</static>
      <pose>  1 -2.5 1 0 0 0</pose>
      <link name="pole_link">
        <visual name="pole_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="pole_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>
    <include>
      <uri>model://stop_light</uri>
      <name>stop_light_2</name>
      <pose>  1 -2.5 2 0 0 0</pose>
      <plugin name="traffic_light_control_2" filename="libtraffic_light_plugin.so">
        <ros>
          <namespace>/stop_light_2</namespace>
          <node_name>stop_light_2_node</node_name>
        </ros>
        <traffic_light_id>2</traffic_light_id>
      </plugin>
    </include>

    <!-- Pole & Stop light 3 -->
    <model name="pole_3">
      <static>true</static>
      <pose> -2.5  1 1 0 0 0</pose>
      <link name="pole_link">
        <visual name="pole_visual">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="pole_collision">
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>2.0</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>
    <include>
      <uri>model://stop_light</uri>
      <name>stop_light_3</name>
      <pose> -2.5  1 2 0 0 -1.5708</pose>
      <plugin name="traffic_light_control_3" filename="libtraffic_light_plugin.so">
        <ros>
          <namespace>/stop_light_3</namespace>
          <node_name>stop_light_3_node</node_name>
        </ros>
        <traffic_light_id>3</traffic_light_id>
      </plugin>
    </include>

  </world>
</sdf>