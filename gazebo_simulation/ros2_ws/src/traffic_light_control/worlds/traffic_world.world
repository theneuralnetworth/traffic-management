<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="TrafficWorld">

    <!-- Sun and ground -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Stop light -->
    <include>
      <uri>model://stop_light</uri>
      <pose>2 2 2 0 0 0</pose>
    </include>

  </world>
</sdf>
