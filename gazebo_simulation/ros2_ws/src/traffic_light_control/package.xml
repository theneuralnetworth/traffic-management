<?xml version="1.0"?>
<package format="3">
  <name>traffic_light_control</name>
  <version>0.0.1</version>
  <description>Plugin to control the stop_light model in Gazebo via ROS 2</description>
  <maintainer email="joanavaz999@gmail.com">Joana</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <depend>rclcpp</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo</depend>
  <depend>traffic_light_msgs</depend>
  
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
